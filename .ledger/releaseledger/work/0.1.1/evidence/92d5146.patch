+        runtime_metadata={"default_max_new_tokens": 11, "default_repetition_penalty": 1.15},
+    )
+
+    measure = runtime.measure_request(SynthesisRequest(id="measure-eot", text="Hello"))
+
+    assert measure.amount == 2 + special_count
