+) -> None:
+    class Tokenizer:
+        def token_to_id(self, token: str) -> int:
+            assert token == "<|endoftext|>"
+            return 99
+
+        def encode(self, text: str, *, add_special_tokens: bool = True) -> Any:
+            ids = [7, 8]
